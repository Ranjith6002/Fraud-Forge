# Copy to backend/.env for local (non-Docker) runs, or to ./.env for `docker compose up`.
# Never commit real credentials.

# Used for local runs. docker-compose overrides this to point at the postgres container.
DATABASE_URL=postgresql+psycopg2://fraud:fraud@localhost:5432/fraud
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS notifications (optional - leave blank and alerts are logged locally instead)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=
SES_FROM_EMAIL=
ALERT_EMAIL=

# auto | sns | ses | both | log | none   (auto = use whichever channels are configured)
NOTIFICATION_PROVIDER=auto

# Optional extra rules, e.g. EXTRA_RULES=device_mismatch
EXTRA_RULES=
